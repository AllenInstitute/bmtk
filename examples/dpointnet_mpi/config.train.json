{
  "manifest": {
    "$ASSET_DIR": "${configdir}/../dpointnet_all2all",
    "$OUTPUT_DIR": "${output_dir}",
    "$NETWORK_DIR": "$ASSET_DIR/network",
    "$MODELS_DIR": "$ASSET_DIR/components"
  },
  "target_simulator": "RNN",
  "run": {
    "seq_len": 64,
    "dt": 1.0,
    "batch_size": 2,
    "default_seed": 17,
    "dtype": "float32",
    "distribution": {
      "strategy": "mpi",
      "global_batch_size": 4
    }
  },
  "rnn_cell_params": {
    "cell_model": "GLIF3Cell",
    "dynamics_mode": "nest",
    "hard_reset": true,
    "hard_reset_gradient_mode": "soft_surrogate",
    "train_recurrent": true,
    "max_delay": 5,
    "tau_basis": [0.7579732, 1.60809441, 3.41168742, 7.23813909],
    "spike_surrogate": "gaussian",
    "spike_surrogate_width": 0.28,
    "spike_surrogate_gain": 0.05,
    "recurrent_spike_gradient_scale": 1.0,
    "voltage_state_gradient_scale": 1.0,
    "detach_reset": true,
    "detach_asc_reset": false,
    "track_voltage_penalty": true,
    "return_voltage_sequences": false,
    "acceleration_profile": "auto"
  },
  "inputs": {
    "poisson_inputs": {
      "node_set": "virts",
      "input": "spikes",
      "module": "poisson_spikes",
      "firing_rate": 500.0,
      "seed": 1234,
      "trainable": false
    }
  },
  "training": {
    "gradient_checkpointing": true,
    "gradient_checkpoint_chunk_size": 16,
    "n_epochs": 2,
    "steps_per_epoch": 2,
    "training_approach": "single",
    "learning_rate": 0.0001,
    "optimizer": {"name": "adam"},
    "initial_state": {"module": "zero_state"},
    "callbacks": {
      "class": "Callbacks",
      "verbose": "on_epoch",
      "memory_report": "off",
      "callbacks_dir": "$OUTPUT_DIR/callbacks"
    },
    "parameters": [{
      "name": "default",
      "inputs": ["poisson_inputs"],
      "loss_functions": {
        "rate": {"module": "TargetFiringRate", "firing_rate": 20.0}
      }
    }]
  },
  "output": {
    "output_dir": "$OUTPUT_DIR",
    "log_file": "run.log",
    "log_level": "INFO",
    "overwrite_output_dir": false
  },
  "components": {
    "point_neuron_models_dir": "$MODELS_DIR/cell_models",
    "synaptic_models_dir": "$MODELS_DIR/synaptic_models"
  },
  "networks": {
    "nodes": [
      {
        "nodes_file": "$NETWORK_DIR/glifs_nodes.h5",
        "node_types_file": "$NETWORK_DIR/glifs_node_types.csv"
      },
      {
        "nodes_file": "$NETWORK_DIR/virts_nodes.h5",
        "node_types_file": "$NETWORK_DIR/virts_node_types.csv"
      }
    ],
    "edges": [
      {
        "edges_file": "$NETWORK_DIR/glifs_glifs_edges.h5",
        "edge_types_file": "$NETWORK_DIR/glifs_glifs_edge_types.csv"
      },
      {
        "edges_file": "$NETWORK_DIR/virts_glifs_edges.h5",
        "edge_types_file": "$NETWORK_DIR/virts_glifs_edge_types.csv"
      }
    ]
  }
}
