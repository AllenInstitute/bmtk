{
  "manifest": {
    "$BASE_DIR": ".",
    "$OUTPUT_DIR": "$BASE_DIR/output",
    "$INPUT_DIR": "$BASE_DIR/inputs",
    "$NETWORK_DIR": "$BASE_DIR/GLIF_network/network",
    "$MODELS_DIR": "$BASE_DIR/GLIF_network/components"
  },
  "target_simulator": "RNN",
  "run": {
    "seq_len": 500,
    "dt": 1.0,
    "batch_size": 5,
    "t_start": 0.0,
    "default_seed": 3000,
    "train_recurrent_weights": true,
    "dtype": "float32",
    "single_gpu_strategy": "one_device",
    "checkpoint": {}
  },
  "rnn_cell_params": {
    "cell_model": "GLIF3Cell",
    "gauss_std": 0.5,
    "dampening_factor": 0.3,
    "recurrent_dampening_factor": 0.5,
    "voltage_gradient_dampening": 0.5,
    "recurrent_weight_scale": 1.0,
    "pseudo_gauss": false,
    "lr_scale": 1.0,
    "max_delay": 5,
    "hard_reset": false
  },
  "training": {
    "n_epochs": 3,
    "steps_per_epoch": 5,
    "learning_rate": {
      "schedule": "warmup_cosine",
      "warmup_start_lr": 0.08,
      "warmup_target_lr": 0.04,
      "warmup_steps": 120,
      "cosine_steps": 880,
      "min_lr": 0.001
    },
    "optimizer": {
      "name": "adam",
      "epsilon": 1.0e-07
    },
    "initial_state": {
      "module": "from_input",
      "inputs": {
        "lgn_gray_screen": {
          "enabled": true,
          "node_set": "lgn",
          "input": "spikes",
          "module": "lgn_tf",
          "stimulus_type": "gray_screen",
          "stimulus_options": {
            "contrast": 0.0,
            "row_size": 80,
            "col_size": 120
          },
          "cell_params": {
            "input_weight_scale": 1.0
          }
        },
        "bkg_inputs": {
          "node_set": "bkg",
          "trainable": false,
          "input": "spikes",
          "module": "noisy_current",
          "seed": null,
          "firing_rate": 250.0
        }
      }
    },
    "parameters": [
      {
        "name": "evoked",
        "inputs": {
          "lgn_inputs": {
            "node_set": "lgn",
            "trainable": true,
            "input": "spikes",
            "module": "lgn_tf",
            "stimulus_type": "drifting_gratings",
            "stimulus_options": {
              "orientation": null,
              "temporal_f": 2.0,
              "row_size": 80,
              "col_size": 120
            }
          },
          "bkg_inputs": {
            "node_set": "bkg",
            "trainable": false,
            "input": "spikes",
            "module": "noisy_current",
            "seed": null,
            "firing_rate": 250.0
          }
        },
        "loss_functions": {
          "evoked_rate_regularizer": {
            "module": "SpikeRateDistributionTarget",
            "rate_cost": 100.0,
            "pre_delay": 100.0,
            "post_delay": 0.0,
            "core_mask": null,
            "stimulus_type": "drifting_gratings",
            "neuropixels_df": "$BASE_DIR/Neuropixels_data/OSI_DSI_neuropixels_v4.csv.gz"
          }
        }
      }
    ]
  },
  "output": {
    "output_dir": "$OUTPUT_DIR",
    "log_file": "log.txt",
    "log_level": "DEBUG",
    "spikes_file": "spikes_ori${matrix:angle}_tf${matrix:tf}_${bmtk:batch_num}.h5",
    "voltages_file": "voltages.h5_ori${matrix:angle}_tf${matrix:tf}_${bmtk:batch_num}.h5",
    "callbacks": {}
  },
  "components": {
    "point_neuron_models_dir": "$MODELS_DIR/cell_models",
    "synaptic_models_dir": "$MODELS_DIR/synaptic_models"
  },
  "networks": {
    "nodes": [
      {
        "nodes_file": "$NETWORK_DIR/v1_nodes.h5",
        "node_types_file": "$NETWORK_DIR/v1_node_types.csv",
        "cache_file": "$BASE_DIR/network_cache/v1_network.pkl",
        "cache_check": "md5sum"
      },
      {
        "nodes_file": "$NETWORK_DIR/lgn_nodes.h5",
        "node_types_file": "$NETWORK_DIR/lgn_node_types.csv",
        "cache_file": "$BASE_DIR/network_cache/lgn_network.pkl"
      },
      {
        "nodes_file": "$NETWORK_DIR/bkg_nodes.h5",
        "node_types_file": "$NETWORK_DIR/bkg_node_types.csv",
        "cache_file": "$BASE_DIR/network_cache/lgn_network.pkl"
      }
    ],
    "edges": [
      {
        "edges_file": "$NETWORK_DIR/v1_v1_edges.h5",
        "edge_types_file": "$NETWORK_DIR/v1_v1_edge_types.csv"
      },
      {
        "edges_file": "$NETWORK_DIR/lgn_v1_edges.h5",
        "edge_types_file": "$NETWORK_DIR/lgn_v1_edge_types.csv"
      },
      {
        "edges_file": "$NETWORK_DIR/bkg_v1_edges.h5",
        "edge_types_file": "$NETWORK_DIR/bkg_v1_edge_types.csv"
      }
    ]
  }
}