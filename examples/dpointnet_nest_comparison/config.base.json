{
  "manifest": {
    "$BASE_DIR": ".",
    "$NETWORK_DIR": "$BASE_DIR/network",
    "$MODELS_DIR": "$BASE_DIR/components"
  },
  "target_simulator": "RNN",
  "run": {
    "dt": 1.0,
    "seq_len": 300,
    "batch_size": 1,
    "default_seed": 3000
  },
  "rnn_cell_params": {
    "cell_model": "GLIF3Cell",
    "dynamics_mode": "nest",
    "tau_basis": [2.0, 4.0, 8.0, 16.0],
    "max_delay": 2.0,
    "train_recurrent": false,
    "track_voltage_penalty": false,
    "return_voltage_sequences": true,
    "acceleration_profile": "auto"
  },
  "initial_state": {"module": "zero_state"},
  "inputs": {
    "replay": {
      "node_set": "virts",
      "input": "spikes",
      "module": "spikes_files",
      "spikes_paths": "inputs/spikes.h5",
      "trainable": false
    }
  },
  "inference": {
    "initial_state": {"module": "zero_state"},
    "inputs": ["replay"]
  },
  "output": {
    "output_dir": "output",
    "log_file": "log.txt",
    "log_level": "INFO",
    "spikes_file": "spikes.h5",
    "voltages_file": "voltages.h5"
  },
  "components": {
    "point_neuron_models_dir": "$MODELS_DIR/cell_models",
    "synaptic_models_dir": "$MODELS_DIR/synaptic_models"
  },
  "networks": {
    "nodes": [
      {"nodes_file": "$NETWORK_DIR/glifs_nodes.h5", "node_types_file": "$NETWORK_DIR/glifs_node_types.csv"},
      {"nodes_file": "$NETWORK_DIR/virts_nodes.h5", "node_types_file": "$NETWORK_DIR/virts_node_types.csv"}
    ],
    "edges": [
      {"edges_file": "$NETWORK_DIR/glifs_glifs_edges.h5", "edge_types_file": "$NETWORK_DIR/glifs_glifs_edge_types.csv"},
      {"edges_file": "$NETWORK_DIR/virts_glifs_edges.h5", "edge_types_file": "$NETWORK_DIR/virts_glifs_edge_types.csv"}
    ]
  }
}
