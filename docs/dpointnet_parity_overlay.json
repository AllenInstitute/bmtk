{
  "run": {
    "dtype": "float16",
    "batch_size": 32,
    "seq_len": 500,
    "dt": 1.0
  },
  "rnn_cell_params": {
    "cell_model": "GLIF3Cell",
    "dynamics_mode": "nest",
    "hard_reset": false,
    "state_precision": "selective",
    "temporal_gradient_precision": "compute",
    "current_replay_mode": null,
    "temporal_checkpoint_chunk_size": 25,
    "temporal_pack_spike_checkpoints": false,
    "pseudo_gauss": true,
    "dampening_factor": 0.05,
    "gauss_std": 0.28,
    "recurrent_dampening_factor": 1.0,
    "voltage_gradient_dampening": 0.0,
    "detach_reset": true,
    "detach_asc_reset": false,
    "lr_scale": 1.0,
    "use_fused_cuda": true,
    "use_fused_state": true,
    "use_pair_projection": true,
    "use_direct_csr_recurrent_gradient": true,
    "use_fixed4_input_forward": true,
    "use_fused_current_accumulation": true,
    "use_fused_recurrent_accumulation": true,
    "use_packed_sm120_backward": true,
    "use_packed_sm120_external_backward": true,
    "use_fused_nest_event_vjp": true,
    "use_prepacked_nest_coefficients": true,
    "use_direct_state_rnn_loop": true,
    "use_javier_recurrent_vjp": true,
    "use_uniform_input_delay_projection": true,
    "use_forward_run_aggregation": true,
    "use_device_active_queue_forward": true,
    "use_native_voltage_penalty": true,
    "use_fused_state_history": true,
    "use_type_indexed_nest_coefficients": true,
    "use_static_type_indexed_nest_dispatch": true,
    "track_voltage_penalty": true,
    "voltage_penalty_mode": "range",
    "return_voltage_sequences": false
  },
  "training": {
    "training_approach": "parallel",
    "learning_rate": 0.003,
    "optimizer": {
      "name": "exp_adam",
      "epsilon": 1e-11,
      "jit_compile": true
    },
    "gradient_checkpointing": true,
    "gradient_checkpoint_chunk_size": 25,
    "pack_spike_checkpoints": false,
    "record_signature_metrics": false,
    "record_mean_rate_metrics": false
  }
}
